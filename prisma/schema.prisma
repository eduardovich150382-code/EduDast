// EduDast — to'liq v1 ma'lumotlar modeli (docs/sessions/01-poydevor.md, 4-band).
// Bu sxema keyingi 12 haftalik rejaga mo'ljallangan: hozir bo'sh jadvallar ham
// yozilgan — keyingi sessiyalarda migratsiya kam bo'lishi uchun.
//
// Izohlar:
// - Barcha `id` maydonlari cuid() — vaqt bo'yicha saralanadigan ID.
// - `embedding vector(768)` ustunlari Prisma Client tomonidan o'qib/yozib
//   bo'lmaydi (Unsupported turi) — ular $queryRaw/$executeRaw orqali
//   ishlatiladi (Prisma docs: postgres-extensions#limitations).
// - SubscriptionPlan, SubscriptionStatus, LessonPlanStatus, GameType va
//   GameSession.state qiymatlari vazifa faylida aniq berilmagan — shu sabab
//   quyida vaqtinchalik (provisional) enum qiymatlari qo'yildi. Bu
//   modellarni haqiqatda ishlatadigan sessiya ularni kerak bo'lsa qayta
//   ko'rib chiqadi.
// - Topic(subjectId, grade) uchun alohida @@index QO'SHILMADI: pastdagi
//   @@unique([subjectId, grade, slug]) allaqachon shu ikki ustunni
//   qamrovchi (leftmost-prefix) B-tree indeks yaratadi — takroriy indeks
//   Neon'ning 0.5GB limitini bekorga yeydi (CLAUDE.md, ma'lumotlar bazasi
//   qoidalari).

generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // Ulanish URL'lari endi shu yerda emas, prisma.config.ts da (Prisma 7).
  extensions = [vector]
}

// ---------- Enumlar ----------

enum Role {
  TEACHER
  ADMIN
}

enum DocumentType {
  LESSON_PLAN
  TEST
  CROSSWORD
  SLIDES
  GUIDE
}

enum DocumentStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum CreditReason {
  PURCHASE
  GENERATION
  REFUND
  REFERRAL
  GRANT
}

enum PaymentMethod {
  MANUAL_CARD
  PAYME
  CLICK
}

enum PaymentStatus {
  PENDING
  PROOF_SUBMITTED
  CONFIRMED
  REJECTED
  EXPIRED
}

/// Provisional — to'lov/obuna sessiyasida aniqlashtiriladi.
enum SubscriptionPlan {
  FREE
  PRO
}

/// Provisional — to'lov/obuna sessiyasida aniqlashtiriladi.
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

/// Provisional — dars rejasi sessiyasida aniqlashtiriladi.
enum LessonPlanStatus {
  PLANNED
  DONE
  CANCELED
}

/// Provisional — o'yin sessiyasida aniqlashtiriladi.
enum GameType {
  QUIZ
  CROSSWORD_RACE
}

/// Provisional — o'yin sessiyasida aniqlashtiriladi.
enum GameSessionState {
  LOBBY
  ACTIVE
  FINISHED
}

/// Ta'til/bayram qamrovi. REGION — viloyat bo'yicha farq qiladigan kunlar
/// (Holiday.region da kod turadi). GLOBAL — butun mamlakat uchun.
enum HolidayScope {
  GLOBAL
  REGION
}

// ---------- Modellar ----------

model User {
  id            String    @id @default(cuid())
  telegramId    BigInt    @unique
  username      String?
  fullName      String
  role          Role      @default(TEACHER)
  region        String?
  subjects      String[]
  grades        Int[]
  locale        String    @default("uz")
  creditBalance Int       @default(0)

  /// Generatsiya davomida BAND qilingan kreditlar. Mavjud balans =
  /// `creditBalance - creditsHeld`.
  ///
  /// NEGA ALOHIDA JADVAL EMAS: shunda `CreditTx` ga faqat pul HAQIQATAN
  /// qimirlaganda qator tushadi (CLAUDE.md 4-qoida) va manfiy `CreditTx`
  /// bilan "hold" qilish kerak emas. Band qilish/bo'shatish — bitta UPDATE,
  /// ya'ni Postgres qator qulfi parallel so'rovlarni navbatga qo'yadi va
  /// mavjud balans manfiyga tushmaydi (lib/credits/ledger.ts).
  creditsHeld   Int       @default(0)

  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  /// Sessiyani bekor qilish uchun. Sessiya JWT'i stateless — serverda
  /// saqlanmaydi, shuning uchun uni "o'chirish"ning yagona yo'li shu:
  /// token ichidagi versiya bu ustundan farq qilsa, sessiya yaroqsiz
  /// (lib/auth/index.ts, auth()). Bu raqamni oshirish — o'sha
  /// foydalanuvchining barcha qurilmalaridagi sessiyani darhol uzadi.
  sessionVersion Int @default(0)

  documents         Document[]
  llmCalls          LlmCall[]
  creditTxs         CreditTx[]
  paymentIntents    PaymentIntent[] @relation("PaymentIntentUser")
  confirmedPayments PaymentIntent[] @relation("PaymentIntentConfirmedBy")
  subscription      Subscription?
  lessonPlans       LessonPlan[]
  hostedGames       GameSession[]
  gamePlayers       GamePlayer[]
  loginTokens       LoginToken[]
}

/// Telegram bot deep-link login uchun bir martalik token.
///
/// NEGA KERAK: Telegram Login Widget brauzerda telefon raqami so'raydi va
/// tasdiqni Telegram xizmat chatiga yuboradi — o'qituvchi telefonida bu
/// oqim tez-tez uzilib qoladi (xabar topilmaydi, kutish oynasi yopiladi).
/// Deep-link oqimida esa brauzer botga havola ochadi, foydalanuvchi
/// "Start" bosadi, bot tokenni tasdiqlaydi, brauzer esa holatni
/// so'rab turib sessiya cookie'sini oladi.
///
/// IKKI SIR (ataylab):
/// - `code` — deep-link ichida Telegram orqali o'tadi, ya'ni YARIM ochiq.
/// - `verifierHash` — brauzerdagi httpOnly cookie'ning SHA-256'si.
///   Holatni so'rash uchun IKKALASI ham kerak, shuning uchun `code` ni
///   ko'rib qolgan uchinchi shaxs sessiyani o'g'irlay olmaydi.
///
/// Qator O'CHIRILMAYDI (CLAUDE.md soft delete qoidasi) — ishlatilgani
/// `consumedAt` bilan belgilanadi va shu bilan qayta ishlatib bo'lmaydi.
model LoginToken {
  id           String    @id @default(cuid())
  code         String    @unique
  verifierHash String
  locale       String
  /// Bot "Start" ni qabul qilgach to'ldiriladi.
  userId       String?
  approvedAt   DateTime?
  /// Brauzer sessiya cookie'sini olgan payt — token shundan keyin o'lik.
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  /// Muddati o'tganlarni davriy tozalash uchun (`code` allaqachon unique,
  /// shuning uchun qidiruv indeksi qo'shilmaydi).
  @@index([expiresAt])
}

model Subject {
  id         String @id @default(cuid())
  slug       String @unique
  nameUz     String
  nameUzCyrl String
  nameRu     String

  /// false — fan onboarding'da "tez orada" belgisi bilan ko'rinadi, lekin
  /// tanlash mumkin va tanlov User.subjects da saqlanadi. Shu orqali qaysi
  /// fan ko'p so'ralayotgani bilinadi (talab bo'lmagan fanga kurikulum
  /// yuklashdan oldin). Default false — yangi fan qo'shilganda u avtomatik
  /// "tez orada" bo'ladi, tayyor bo'lgani ataylab true qilinadi.
  isActive Boolean @default(false)

  topics Topic[]
}

/// O'quv yili — choraklar va ta'tillarning egasi (07-sessiya).
///
/// `isActive` bitta yilda bo'lishi kerak, lekin unique indeks bilan
/// ifodalanmaydi (Postgres'da "faqat bitta true" sharti partial unique
/// talab qiladi va u Prisma sxemasida yozilmaydi). Shuning uchun shartni
/// `server/calendar-actions.ts` bitta tranzaksiyada saqlaydi, o'qiydigan
/// tomon esa `orderBy` + `take: 1` bilan aniq bittasini oladi.
model AcademicYear {
  id       String   @id @default(cuid())
  /// "2026–2027" — ko'rinadigan nom. Takrorlanmasin: bir yil ikki marta
  /// kiritilsa qaysi biri faol ekani chalkashardi.
  label    String   @unique
  startsOn DateTime
  endsOn   DateTime
  isActive Boolean  @default(false)

  quarters Quarter[]
  holidays Holiday[]
}

model Quarter {
  id             String   @id @default(cuid())
  academicYearId String
  /// 1–4.
  number         Int
  startsOn       DateTime
  endsOn         DateTime

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  /// Alohida @@index([academicYearId]) QO'SHILMADI — bu @@unique allaqachon
  /// shu ustunni qamrovchi (leftmost-prefix) indeks yaratadi.
  @@unique([academicYearId, number])
}

/// Chorak ICHIDAGI ta'til va bayramlar (Navro'z, Mustaqillik kuni).
///
/// Kuz/qish ta'tili bu yerga YOZILMAYDI — u shunchaki choraklar orasidagi
/// bo'shliq va `placement.ts` unga dars qo'ymaydi (chorak a'zoligi asosiy
/// filtr). Aks holda admin bir narsani ikki marta kiritardi.
model Holiday {
  id             String       @id @default(cuid())
  academicYearId String
  startsOn       DateTime
  endsOn         DateTime
  label          String
  scope          HolidayScope @default(GLOBAL)
  /// scope=REGION bo'lganda lib/uz-regions.ts dagi kodlardan bittasi,
  /// GLOBAL bo'lganda null. Ikki tomonlama shart Zod'da tekshiriladi.
  region         String?

  /// Soft delete (CLAUDE.md). O'chirilgan ta'til hisobga olinmaydi, lekin
  /// "nega sanalar o'zgardi" savoliga javob iz sifatida qoladi.
  deletedAt DateTime?

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  /// Sabab: "Rejam" har yuklashda faol yilning ta'tillarini o'qiydi.
  @@index([academicYearId])
}

model Topic {
  id          String                      @id @default(cuid())
  subjectId   String
  parentId    String?
  grade       Int
  slug        String
  titleUz     String
  titleUzCyrl String
  titleRu     String
  order       Int
  objectives  String[]
  keywords    String[]
  hoursPlan   Int?
  /// Mavzu qaysi chorakda o'tiladi (1–4). `null` — chorak belgilanmagan,
  /// u holda mavzu `order` bo'yicha ketma-ket, chorak chegarasidan erkin
  /// oqib o'tadi. Belgilangan bo'lsa mavzu o'sha chorak ichida tugaydi
  /// (kerak bo'lsa tig'izlashadi) — lib/calendar/placement.ts.
  quarter     Int?
  /// pgvector ustuni — faqat raw SQL orqali o'qiladi/yoziladi.
  ///
  /// OGOHLANTIRISH — HNSW INDEKSI: bu ustunning `Topic_embedding_hnsw_idx`
  /// indeksi faqat migratsiya fayllarida yashaydi (`@@index` ni
  /// `Unsupported` ustunga yozib bo'lmaydi). Prisma sxemada ko'rmagan
  /// indeksni HAR `migrate dev` da DROP qiladi — bu 2026-09-26 da
  /// `embedding_provenance` migratsiyasida haqiqatan yuz berdi.
  /// Shuning uchun: yangi migratsiya yasagach, migration.sql ni O'QING va
  /// `DROP INDEX ... hnsw ...` bo'lsa CREATE ni oxiriga qaytarib qo'ying
  /// (namuna: `20260926102914_embedding_hnsw_restore`).
  embedding   Unsupported("vector(768)")?

  /// Vektor QAYSI model bilan yozilgan. Model almashsa hamma vektor
  /// eskiradi, va buni bilishning yagona yo'li — shu ustun.
  embeddingModel String?
  /// Vektor yozilgan payt. `null` — hali yozilmagan. NAVBAT SHU:
  /// `embeddedAt IS NULL` ning o'zi ish ro'yxati (Redis/queue kerak emas).
  embeddedAt     DateTime?
  /// `embeddedAt < updatedAt` — eskirish shartining ikkinchi yarmi. CSV
  /// import yoki boshqa yo'l matnni o'zgartirsa, admin panelidan
  /// o'tmagan bo'lsa ham vektor eskirgan deb bilinadi.
  updatedAt      DateTime  @default(now()) @updatedAt

  /// Soft delete (CLAUDE.md). Mavzu o'chirilsa ham unga bog'langan
  /// Document/LessonPlan/GameSession yozuvlari yetim qolmaydi.
  /// DIQQAT: @@unique([subjectId, grade, slug]) o'chirilgan qatorni ham
  /// qamraydi — CSV import o'sha slug'ni qayta uchratsa yangi qator
  /// YARATMAYDI, mavjudini tiriltiradi (deletedAt: null).
  /// $queryRaw qidiruvda bu filtr QO'LDA yoziladi (lib/curriculum/search.ts).
  deletedAt DateTime?

  subject  Subject @relation(fields: [subjectId], references: [id])
  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id])
  children Topic[] @relation("TopicHierarchy")

  sourceChunks SourceChunk[]
  documents    Document[]
  lessonPlans  LessonPlan[]
  gameSessions GameSession[]

  @@unique([subjectId, grade, slug])
  @@index([parentId])
}

model SourceChunk {
  id        String                      @id @default(cuid())
  topicId   String
  sourceRef String
  content   String                      @db.Text
  /// pgvector ustuni — faqat raw SQL orqali o'qiladi/yoziladi.
  embedding Unsupported("vector(768)")?

  /// Topic dagi bilan bir xil ma'no. Bo'lakda `updatedAt` YO'Q: bo'lak
  /// matni tahrirlanmaydi, manba qayta import qilinsa qator almashadi.
  embeddingModel String?
  embeddedAt     DateTime?

  topic Topic @relation(fields: [topicId], references: [id])

  @@index([topicId])
}

model Document {
  id           String         @id @default(cuid())
  userId       String
  topicId      String
  type         DocumentType
  title        String
  status       DocumentStatus @default(QUEUED)

  /// Generatsiya boshlangan payt — 08-SESSIYADAGI REAPER UCHUN.
  ///
  /// NEGA KERAK: brauzer yopilib jarayon yarim yo'lda uzilsa, hujjat abadiy
  /// `RUNNING` bo'lib qoladi. `hold()` `CreditTx` ga HECH NARSA yozmaydi,
  /// ya'ni band qolgan kredit daftarda iz qoldirmaydi — foydalanuvchi balansi
  /// jimgina kamayadi va `creditsHeld` abadiy band bo'lib turadi. Reaper
  /// (08-sessiya) aynan shu ustun orqali eskirgan `RUNNING` hujjatni topadi
  /// va `release()` bilan kreditni qaytaradi. 06-sessiyada `hold()` ni
  /// chaqiradigan kod yo'q, shuning uchun bu yerda faqat ustunning o'zi.
  ///
  /// IKKI SOAT: taqqoslashda ikkala tomon BITTA manbadan bo'lsin — `startedAt`
  /// raw SQL `NOW()` bilan yozilsin va reaper `NOW() - interval '15 minutes'`
  /// bilan solishtirsin. Prisma'dan kelgan `new Date()` (ishlab chiquvchi
  /// soati) ni `NOW()` (Neon soati) bilan solishtirish beqaror test va prodda
  /// cheksiz qayta ishlov beradi (lib/curriculum/embed.ts dagi sabab).
  startedAt    DateTime?

  /// Nega yiqildi — foydalanuvchiga ko'rinadigan qisqa sabab (`LlmErrorKind`
  /// yoki sifat tekshiruvi izohi). `release()` 500 belgiga qisqartirib yozadi.
  failReason   String?

  /// Shu hujjat uchun BAND qilingan kredit.
  ///
  /// NEGA KERAK: `hold()` `CreditTx` yozmaydi, `creditsUsed` esa faqat
  /// `charge()` da to'ldiriladi — ya'ni band qilingan miqdor boshqa hech
  /// qayerda saqlanmaydi. Reaper (08-sessiya, `api/cron/stale-documents`)
  /// `release(userId, AMOUNT, ...)` chaqiradi va o'sha `AMOUNT` ni oladigan
  /// joyi bo'lmaydi. `inputParams` dan `creditCost()` bilan QAYTA HISOBLAB
  /// BO'LMAYDI: narx jadvali 08-sessiyadan keyin o'lchangan xarajatga qarab
  /// qayta belgilanadi, ya'ni eski hujjat uchun boshqa son chiqadi va
  /// `creditsHeld` abadiy siljib ketadi.
  ///
  /// KIM YOZADI: `hold()` ning o'zi emas (u faqat `User` qatorini qulflaydi) —
  /// 08-sessiya `hold(cost)` va `Document.create({ creditsHeldFor: cost })`
  /// ni BITTA `$transaction` ichida bajaradi, ya'ni ikkisi hamisha mos keladi.
  creditsHeldFor Int          @default(0)

  inputParams  Json
  contentJson  Json
  qualityScore Float?
  qualityNotes Json?
  creditsUsed  Int            @default(0)
  createdAt    DateTime       @default(now())
  deletedAt    DateTime?

  user  User  @relation(fields: [userId], references: [id])
  topic Topic @relation(fields: [topicId], references: [id])

  exports  Export[]
  llmCalls LlmCall[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([topicId])
}

model Export {
  id         String   @id @default(cuid())
  documentId String
  format     String
  url        String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id])

  @@index([documentId])
}

/// Har LLM chaqiruvi shu yerga yoziladi — marjani ko'rish uchun,
/// hech qachon o'chirilmaydi (CLAUDE.md, 3-qoida).
model LlmCall {
  id         String   @id @default(cuid())
  documentId String?
  /// `null` — tizim chaqiruvi (embedding backfill, cron). Soxta
  /// foydalanuvchi yaratmaslik uchun ixtiyoriy.
  userId     String?
  /// "anthropic" | "gemini". A/B solishtiruvi shu ustun bo'yicha.
  provider   String
  model      String
  /// JAMI kirish: keshsiz + keshdan o'qilgan + keshga yozilgan.
  /// Taqsimot `costUsd` ichida allaqachon hisobga olingan.
  tokensIn   Int
  tokensOut  Int
  costUsd    Decimal  @db.Decimal(10, 6)
  purpose    String
  /// `null` — urinish muvaffaqiyatli tugagan. Aks holda `LlmErrorKind`
  /// ("rate_limit", "overloaded", "unknown"...). Sababi: yiqilgan urinish
  /// ham pul turishi mumkin, lekin `costUsd = 0` qator muvaffaqiyatli
  /// bepul chaqiruvdan farq qilmay qolardi.
  errorKind  String?
  createdAt  DateTime @default(now())

  document Document? @relation(fields: [documentId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([documentId])
  /// Byudjet shifti har LLM chaqiruvidan oldin oylik va kunlik
  /// SUM(costUsd) ni o'qiydi. Bu indekssiz so'rov jadval o'sgani sari
  /// to'liq skanga aylanadi — Neon'da ham sekin, ham pullik.
  @@index([createdAt])
}

model CreditTx {
  id           String       @id @default(cuid())
  userId       String
  delta        Int
  reason       CreditReason
  refId        String?
  balanceAfter Int
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model PaymentIntent {
  id            String        @id @default(cuid())
  userId        String
  code          String        @unique @db.VarChar(8)
  sku           String
  amountSum     Int
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  proofUrl      String?
  // @unique: bir xil to'lov isboti (chek/screenshot hash'i) ikkinchi marta
  // boshqa PaymentIntent'ga bog'lanmasin — aks holda bitta chek bilan
  // ikki marta kredit sotib olish mumkin bo'lib qoladi (pul yo'qoladi).
  // Nullable maydonda bir nechta NULL ruxsat etiladi (Postgres unique
  // index qoidasi) — proof hali yuklanmagan PENDING intentlar to'qnashmaydi.
  proofHash     String?       @unique
  confirmedById String?
  confirmedAt   DateTime?
  expiresAt     DateTime
  rawPayload    Json?
  createdAt     DateTime      @default(now())

  user        User  @relation("PaymentIntentUser", fields: [userId], references: [id])
  confirmedBy User? @relation("PaymentIntentConfirmedBy", fields: [confirmedById], references: [id])

  @@index([status])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  plan      SubscriptionPlan
  status    SubscriptionStatus
  periodEnd DateTime
  source    String?

  user User @relation(fields: [userId], references: [id])
}

model LessonPlan {
  id          String           @id @default(cuid())
  userId      String
  topicId     String
  classLabel  String
  scheduledAt DateTime?
  documentIds String[]
  status      LessonPlanStatus @default(PLANNED)

  user  User  @relation(fields: [userId], references: [id])
  topic Topic @relation(fields: [topicId], references: [id])

  @@index([userId])
  @@index([topicId])
}

model GameSession {
  id        String           @id @default(cuid())
  hostId    String
  topicId   String
  gameType  GameType
  joinCode  String           @unique
  questions Json
  state     GameSessionState @default(LOBBY)
  startedAt DateTime?

  host  User  @relation(fields: [hostId], references: [id])
  topic Topic @relation(fields: [topicId], references: [id])

  players GamePlayer[]

  @@index([topicId])
}

model GamePlayer {
  id        String  @id @default(cuid())
  sessionId String
  nickname  String
  userId    String?
  score     Int     @default(0)
  answers   Json

  session GameSession @relation(fields: [sessionId], references: [id])
  user    User?       @relation(fields: [userId], references: [id])

  @@index([sessionId])
}
