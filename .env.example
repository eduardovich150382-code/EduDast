# --- Ma'lumotlar bazasi (Neon) ---
# Pooled ulanish — runtime (@prisma/adapter-neon shu orqali ishlaydi).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# To'g'ridan-to'g'ri (pooled bo'lmagan) ulanish — faqat migratsiya/seed uchun
# (prisma.config.ts). Neon konsolida "Direct connection" nomi bilan beriladi.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Telegram (Auth.js login — keyingi sessiyada ulanadi) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Admin xabarnomalari (masalan to'lov isboti) yuboriladigan chat ID.
TELEGRAM_ADMIN_CHAT_ID=""

# --- Cloudflare R2 (fayllar: eksportlar, to'lov isbotlari) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# --- Sentry (bo'sh qoldirilsa, xato kuzatuvi jim o'chadi — xato bermaydi) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build vaqtida source-map yuklash uchun (ixtiyoriy) — ikkalasi ham
# to'ldirilmasa, bu bosqich butunlay chetlab o'tiladi.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- PostHog (bo'sh qoldirilsa, jim o'chadi) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Byudjet va generatsiya ---
# Oylik LLM xarajat shifti (AQSH dollarida). Oshsa arzon modelga tushiladi
# yoki generatsiya xato qaytaradi (CLAUDE.md, 5-qoida).
LLM_MONTHLY_BUDGET_USD="50"
# "false" bo'lsa, generatsiya butunlay o'chirilgan bo'ladi (bu sessiyada
# generatsiya mantig'i yo'q, shuning uchun amalda ishlatilmaydi — keyingi
# sessiyalar uchun tayyorlab qo'yilgan).
GENERATION_ENABLED="false"
