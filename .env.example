# --- Ma'lumotlar bazasi (Neon) ---
# Pooled ulanish — runtime (@prisma/adapter-neon shu orqali ishlaydi).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# To'g'ridan-to'g'ri (pooled bo'lmagan) ulanish — faqat migratsiya/seed uchun
# (prisma.config.ts). Neon konsolida "Direct connection" nomi bilan beriladi.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Telegram Login ---
# BotFather'dan olingan token. Widget payload'ining HMAC imzosini shu token
# bilan tekshiramiz — hech qachon log qilinmaydi va client'ga yuborilmaydi.
TELEGRAM_BOT_TOKEN=""
# Bot username'i (@ belgisisiz) — Telegram Login Widget shuni talab qiladi.
# BotFather'da /setdomain orqali widget ishlaydigan domen ham qadalishi shart.
TELEGRAM_BOT_USERNAME=""
# Admin xabarnomalari (masalan to'lov isboti) yuboriladigan chat ID.
TELEGRAM_ADMIN_CHAT_ID=""
# Bot webhook'ini himoya qiluvchi sir. `openssl rand -hex 32` bilan yarating.
# Telegram uni har so'rovda `X-Telegram-Bot-Api-Secret-Token` sarlavhasida
# qaytaradi; mos kelmasa /api/telegram/webhook 401 beradi. Sozlanmagan
# bo'lsa webhook BUTUNLAY yopiq (ya'ni bot javob bermaydi) — bu ataylab.
# O'zgartirgandan keyin `pnpm tg:webhook` ni QAYTA ishga tushiring.
TELEGRAM_WEBHOOK_SECRET=""

# --- Sessiya ---
# `openssl rand -base64 32` bilan yarating. Kamida 32 BAYT bo'lishi shart,
# aks holda ilova ishga tushmaydi. Har muhitda BOSHQA qiymat bo'lsin.
# Qiymatni almashtirish barcha foydalanuvchilarni tizimdan chiqaradi.
SESSION_SECRET=""

# --- Dev login (FAQAT lokal ishlash uchun) ---
# Telegram Login localhost'da ishlamaydi (BotFather domen talab qiladi),
# shuning uchun lokalda seed'dagi test o'qituvchisiga kirish tugmasi bor.
# Tugma faqat NODE_ENV=development VA bu "true" bo'lganda ko'rinadi.
# Vercel'da HECH QACHON "true" qilinmasin.
DEV_LOGIN_ENABLED="false"

# --- Cloudflare R2 (fayllar: eksportlar, to'lov isbotlari) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# --- Sentry (bo'sh qoldirilsa, xato kuzatuvi jim o'chadi — xato bermaydi) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build vaqtida source-map yuklash uchun (ixtiyoriy) — ikkalasi ham
# to'ldirilmasa, bu bosqich butunlay chetlab o'tiladi.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- PostHog (bo'sh qoldirilsa, jim o'chadi) ---
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Byudjet va generatsiya ---
# Oylik LLM xarajat shifti (AQSH dollarida). Oshsa arzon modelga tushiladi
# yoki generatsiya xato qaytaradi (CLAUDE.md, 5-qoida).
LLM_MONTHLY_BUDGET_USD="50"
# "false" bo'lsa, generatsiya butunlay o'chirilgan bo'ladi (bu sessiyada
# generatsiya mantig'i yo'q, shuning uchun amalda ishlatilmaydi — keyingi
# sessiyalar uchun tayyorlab qo'yilgan).
GENERATION_ENABLED="false"
